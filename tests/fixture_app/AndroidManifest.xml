<?xml version="1.0" encoding="utf-8" standalone="no"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.vulnapp">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.READ_SMS"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <application android:allowBackup="true" android:debuggable="true" android:label="VulnApp" android:networkSecurityConfig="@xml/network_security_config" android:usesCleartextTraffic="true">
        <activity android:exported="true" android:name="com.example.vulnapp.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:exported="true" android:name="com.example.vulnapp.PaymentActivity">
            <intent-filter>
                <action android:name="com.example.vulnapp.PAY"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity android:name="com.example.vulnapp.PrivateActivity"/>
        <service android:exported="true" android:name="com.example.vulnapp.SyncService"/>
        <receiver android:exported="true" android:name="com.example.vulnapp.BootReceiver" android:permission="android.permission.RECEIVE_BOOT_COMPLETED"/>
        <provider android:authorities="com.example.vulnapp.notes" android:exported="true" android:name="com.example.vulnapp.NotesProvider"/>
    </application>
</manifest>
